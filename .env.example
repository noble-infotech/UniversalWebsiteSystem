# TEMPLATE ONLY – never put real passwords, keys or service-account JSON in this file (it is committed to git).
# Enter real values in your hosting provider (Vercel → Settings → Environment Variables)
# or in a local, git-ignored .env.local file.
#
# Which company configuration to serve (folder name under /sites)
SITE_ID=maison-lumiere
# Allow the ?site= / cookie switcher used to demo multiple companies from one deployment.
# Set to "false" in real client deployments.
ENABLE_SITE_SWITCHER=true
# Public origin used for canonical URLs, sitemap and Open Graph (overrides config.company.websiteUrl)
SITE_URL=
# Deliver form submissions to a webhook (Zapier/Make/n8n/CRM) – used when a site sets integrations.forms.provider = "webhook"
FORMS_WEBHOOK_URL=
# Stripe secret key – enables the Stripe Checkout adapter for sites with commerce.payment.provider = "stripe"
STRIPE_SECRET_KEY=
# Set to "true" where the server cannot reach remote image hosts (e.g. sandboxed CI)
NEXT_IMAGE_UNOPTIMIZED=
# This site's OWN Firebase project (Firestore) for admin edits, enquiries, orders and images.
# Value = the full service-account JSON from Firebase → Project settings → Service accounts → Generate new private key.
# Enter it in Vercel → Settings → Environment Variables – never here.
FIREBASE_SERVICE_ACCOUNT=
# Several sites on ONE deployment: FIREBASE_SERVICE_ACCOUNT_<SITE_ID> per site, and set
# ISOLATE_SITE_STORAGE=true so no site ever falls back to the shared FIREBASE_SERVICE_ACCOUNT.
ISOLATE_SITE_STORAGE=
# Local development/tests against the Firestore emulator (npx firebase emulators:start --only firestore --project demo-uws)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Admin login. Use ADMIN_PASSWORD_<SITE_ID> (e.g. ADMIN_PASSWORD_MAISON_LUMIERE) for per-site passwords on a shared deployment.
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (openssl rand -hex 32)
ADMIN_SECRET=
